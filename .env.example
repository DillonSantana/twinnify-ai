# Copy to .env.local and fill in. Never commit .env.local.
# None of these may use the NEXT_PUBLIC_ prefix: they are server-only.

# ElevenLabs API key. Create a dedicated key restricted to Agents permissions.
ELEVENLABS_API_KEY=

# ID of the ElevenLabs agent for the demo participant (created in Phase 2).
ELEVENLABS_AGENT_ID_ENI=
